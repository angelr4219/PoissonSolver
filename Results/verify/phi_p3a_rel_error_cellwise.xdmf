<?xml version="1.0"?>
<!DOCTYPE Xdmf SYSTEM "Xdmf.dtd" []>
<Xdmf Version="3.0" xmlns:xi="https://www.w3.org/2001/XInclude">
  <Domain>
    <Grid Name="mesh" GridType="Uniform">
      <Topology TopologyType="Tetrahedron" NumberOfElements="423360" NodesPerElement="4">
        <DataItem Dimensions="423360 4" NumberType="Int" Format="HDF">phi_p3a_rel_error_cellwise.h5:/Mesh/mesh/topology</DataItem>
      </Topology>
      <Geometry GeometryType="XYZ">
        <DataItem Dimensions="75809 3" Format="HDF">phi_p3a_rel_error_cellwise.h5:/Mesh/mesh/geometry</DataItem>
      </Geometry>
    </Grid>
    <Grid Name="rel_error_cell" GridType="Collection" CollectionType="Temporal">
      <Grid Name="rel_error_cell" GridType="Uniform">
        <xi:include xpointer="xpointer(/Xdmf/Domain/Grid[@GridType='Uniform'][1]/*[self::Topology or self::Geometry])" />
        <Time Value="0" />
        <Attribute Name="rel_error_cell" AttributeType="Scalar" Center="Cell">
          <DataItem Dimensions="423360 1" Format="HDF">phi_p3a_rel_error_cellwise.h5:/Function/rel_error_cell/0</DataItem>
        </Attribute>
      </Grid>
    </Grid>
  </Domain>
</Xdmf>
