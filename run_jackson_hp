#!/usr/bin/env bash
set -e

# ============================
# User-controlled parameters
# ============================

OUTDIR="results/jackson_conv"
SCRIPT="jackson_point_charge_interface.py"

# Geometry
Lx="1.0e-7"
Ly="1.0e-7"
Lz="1.0e-7"

# Dielectrics
EPS1R="11.7"
EPS2R="3.9"

# Charge parameters
Q="1.602176634e-19"
Z0="1.0e-8"
SIGMA="5.0e-9"

# Refinement parameters
P_LIST=(1 2 3 4)
H_LIST=(2.0e-8 1.0e-8 5.0e-9 2.5e-9)

# Boundary condition mode
BC_MODE="exact"

# Docker image
IMAGE="dolfinx/dolfinx:stable"

# ============================
# Setup
# ============================

mkdir -p "${OUTDIR}"

echo "=========================================="
echo "Running Jackson Poisson hp-refinement"
echo "Output directory: ${OUTDIR}"
echo "=========================================="

# ============================
# Main sweep
# ============================

for p in "${P_LIST[@]}"; do
  for h in "${H_LIST[@]}"; do

    BASENAME="jackson_L${Lx}_h${h}_p${p}"

    echo "------------------------------------------"
    echo "p = ${p}, h = ${h}"
    echo "basename = ${BASENAME}"
    echo "------------------------------------------"

    docker run --rm \
      -v "$PWD":/app \
      -w /app \
      "${IMAGE}" \
      /dolfinx-env/bin/python3 -u "${SCRIPT}" \
        --Lx "${Lx}" --Ly "${Ly}" --Lz "${Lz}" \
        --h "${h}" \
        --deg "${p}" \
        --eps1r "${EPS1R}" --eps2r "${EPS2R}" \
        --q "${Q}" --z0 "${Z0}" --sigma "${SIGMA}" \
        --bc "${BC_MODE}" \
        --outdir "${OUTDIR}" \
        --basename "${BASENAME}"

  done
done

echo "=========================================="
echo "All runs completed."
echo "CSV log:"
echo "  ${OUTDIR}/jackson_runs.csv"
echo "=========================================="

